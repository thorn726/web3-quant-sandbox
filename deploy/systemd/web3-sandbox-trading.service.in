[Unit]
Description=Web3 quant sandbox trading worker (reconcile + freshness + heartbeat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{REPO_DIR}}
EnvironmentFile=-{{REPO_DIR}}/.env
ExecStart={{REPO_DIR}}/.venv/bin/python {{REPO_DIR}}/scripts/trading_worker.py
# Reconciliation differences trip the circuit breaker on disk; the worker
# itself never submits orders.
